{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AetherHUD",
  "version": "0.1.0",
  "identifier": "com.halfbeer.aetherhud",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5789",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "AetherHUD",
        "width": 1080, "height": 720,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
